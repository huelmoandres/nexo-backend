// =============================================================================
// NEXOS - PRISMA SCHEMA (HRProgrammers)
// Fuente única de verdad para la base de datos PostgreSQL de Nexos.
// El schema incluye entidades activas y entidades planificadas del roadmap.
// La disponibilidad productiva se define por modulos Nest implementados en /src/modules.
//
// IMPORTANTE — Extensiones de base de datos requeridas:
// Ejecutar manualmente en PostgreSQL antes de la primera migración:
//   CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
//   CREATE EXTENSION IF NOT EXISTS "postgis";
//
// Convenciones:
//   - Dinero: campos *Cents son Int (minor units × 10^minorUnits).
//     Job/líneas: moneda del contrato (UYU o USD). Escrow.amountCents: siempre UYU (liquidación).
//     Ver .harness/rules/money-rules.md y MoneyConversionService.
//   - Fechas: TIMESTAMPTZ — siempre UTC. Usar date-fns en la capa de Service.
//   - Soft Delete: las tablas con deletedAt NUNCA se borran físicamente.
//     Siempre update({ data: { deletedAt: new Date() } }).
//   - PostGIS: las columnas `location` usan geography(Point, 4326).
//     Toda operación geoespacial ocurre en SQL raw (prisma.$queryRaw).
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuidOssp(map: "uuid-ossp"), postgis]
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  CLIENT
  INDEPENDENT_PRO
  COMPANY_ADMIN
  COMPANY_EMPLOYEE
  SUPER_ADMIN
}

enum KycStatus {
  UNVERIFIED
  PENDING_KYC
  VERIFIED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TrustStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum VerificationLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum VerificationSubjectType {
  PROFESSIONAL
  COMPANY
}

enum VerificationDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationDocumentType {
  IDENTITY_CARD
  SELFIE
  PROOF_OF_ADDRESS
  RUT_PROOF
  COMPANY_INCORPORATION
  PROFESSIONAL_CERTIFICATION
}

/// Estado de verificación de RUT vía constancia DGI (empresa o profesional con RUT).
enum DgiVerificationStatus {
  UNVERIFIED
  PROCESSING
  VERIFIED_AUTO
  PENDING_MANUAL_REVIEW
  REJECTED
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
  CUSTOM
}

enum SubscriptionBillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum JobStatus {
  PENDING          // Publicado, esperando profesional
  ACCEPTED         // Profesional asignado, trabajo no iniciado
  IN_PROGRESS      // Trabajo en curso
  COMPLETED        // Profesional marcó como terminado, esperando conformidad (48hs)
  PENDING_APPROVAL // Legacy alias del periodo post-COMPLETED — preferir COMPLETED + approvalDeadline
  CLOSED           // Conformidad dada, Escrow liberado
  CANCELLED        // Cancelado antes de inicio
}

enum JobPricingMode {
  ESTIMATE
  FIXED
}

enum JobPriceLineType {
  LABOR
  MATERIAL
  OTHER
}

enum JobChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EscrowStatus {
  PENDING        // Creado, pendiente de fondeo
  HELD           // Dinero retenido, trabajo en curso
  HELD_DISPUTED  // Disputa abierta, fondos congelados
  RELEASED       // Fondos liberados al profesional (estado terminal exitoso)
  REFUNDED       // Fondos devueltos al cliente (estado terminal de cancelación)
}

enum EscrowPayoutStatus {
  NOT_APPLICABLE // Sin payout aún (PENDING/HELD) o v1 sin ejecución
  PENDING        // Liberación aprobada; payout en curso
  SUCCEEDED      // MP confirmó transferencia al pro
  FAILED         // MP rechazó — reintentable
  CANCELLED      // Reintentos cancelados por operaciones
}

enum PayoutMethod {
  MERCADO_PAGO
  BANK
}

enum PayoutSubjectType {
  PROFESSIONAL
  COMPANY
}

enum PayoutIdentifierType {
  MP_CVU
  MP_ALIAS
  MP_EMAIL
  MP_PHONE
  BANK_TRANSFER_KEY
}

enum PayoutAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PayoutAttemptTrigger {
  RELEASE_FLOW
  ADMIN_RETRY
  ADMIN_MANUAL
  SYSTEM_RETRY
}

enum DisputeStatus {
  OPEN                  // Disputa iniciada
  SECOND_CHANCE         // Se habilitó re-visita técnica de 48hs
  MEDIATION_LOCKED      // Solo SUPER_ADMIN puede resolver
  RESOLVED_PRO_FAVOR    // Resuelto a favor del profesional → Escrow RELEASED
  RESOLVED_CLIENT_FAVOR // Resuelto a favor del cliente → Escrow REFUNDED
  RESOLVED              // Resolución acordada entre partes (autogestión)
}

enum EvidenceType {
  BEFORE_PHOTO      // Foto del estado antes del trabajo (alto valor en disputa)
  AFTER_PHOTO       // Foto del estado al finalizar (alto valor en disputa)
  MATERIAL_RECEIPT  // Recibo de materiales — solo válido si uploadedAt < dispute.createdAt
  CHAT_SCREENSHOT   // Captura referencial (bajo valor, el chat interno ya existe)
  CLIENT_COMPLAINT  // Descripción escrita del cliente (referencial)
}

enum ReviewStatus {
  PENDING_PHOTOS // Scores guardados, esperando fotos Before/After
  VALIDATED      // Reseña visible públicamente
  REJECTED       // Moderada y ocultada por SUPER_ADMIN
}

enum UrgencyStatus {
  BROADCAST  // Alerta activa, buscando profesional (Weighted Broadcast en curso)
  ACCEPTED   // Primer profesional asignó el trabajo
  COMPLETED  // Trabajo finalizado
  EXPIRED    // Nadie aceptó antes del deadline (configurable, default 30min)
  CANCELLED  // Cliente canceló antes de asignación
}

enum NotificationType {
  URGENCY_DISPATCHED  // Nueva urgencia disponible para el profesional
  URGENCY_ACCEPTED    // Alguien aceptó la urgencia del cliente
  ESCROW_FUNDED       // El cliente fondeó el Escrow
  ESCROW_RELEASED     // Fondos liberados al profesional
  DISPUTE_OPENED      // Se abrió una disputa en un trabajo
  DISPUTE_RESOLVED    // La disputa fue resuelta
  KYC_APPROVED        // Verificación de identidad aprobada
  KYC_REJECTED        // Verificación de identidad rechazada
  REVIEW_VALIDATED    // Una reseña fue validada y es pública
  SYSTEM              // Mensajes del sistema (actualizaciones, mantenimiento)
  // Portfolio
  PORTFOLIO_AI_FLAGGED        // Item del profesional flaggeado por IA — requiere corrección
  PORTFOLIO_CONSENT_REQUESTED // Cliente recibe solicitud de verificación de badge
  PORTFOLIO_CONSENT_REMINDER  // Recordatorio de consent pendiente (delay 3 días)
  PORTFOLIO_CONSENT_RESOLVED  // Profesional recibe resultado del consent (aceptado/rechazado)
  // Billing / suscripciones SaaS
  SUBSCRIPTION_PAYMENT_FAILED
  SUBSCRIPTION_GRACE_REMINDER
  SUBSCRIPTION_DOWNGRADED
}

enum AuditAction {
  USER_CREATED
  COMPANY_CREATED
  // Financieros (Escrow)
  FUND_ESCROW
  RELEASE_FUNDS
  REFUND_CLIENT
  PAYOUT_ACCOUNT_CREATED
  PAYOUT_ACCOUNT_UPDATED
  PAYOUT_ACCOUNT_SET_PRIMARY
  PAYOUT_ATTEMPT_CREATED
  PAYOUT_SUCCEEDED
  PAYOUT_FAILED
  RETRY_PAYOUT
  // Disputas
  OPEN_DISPUTE
  SECOND_CHANCE_ACTIVATED
  LOCK_MEDIATION
  RESOLVE_PRO
  RESOLVE_CLIENT
  // Identidad y roles
  ROLE_CHANGED          // Cambio de rol en User — auditoría crítica de seguridad
  KYC_STATUS_CHANGED
  // Trabajos
  JOB_STATUS_CHANGED
  JOB_ASSIGNED
  // Evidencia
  EVIDENCE_UPLOADED
  EVIDENCE_DELETED      // Soft delete de evidencia — inmutable en producción
  // Empresa
  EMPLOYEE_ACTION       // Acción de un COMPANY_EMPLOYEE — filtrable por companyId
  EMPLOYEE_ADDED
  EMPLOYEE_REMOVED
  // Portfolio
  PORTFOLIO_CONSENT_ACCEPTED  // Cliente aceptó verificación de un item
  PORTFOLIO_CONSENT_DECLINED  // Cliente rechazó verificación de un item
  PORTFOLIO_ITEM_REPORTED      // Usuario autenticado reportó un item publicado
  PORTFOLIO_ADMIN_MODERATED    // SUPER_ADMIN resolvió la cola de moderación manual
}

enum PortfolioItemStatus {
  DRAFT                  // Creado sin fotos o no publicado todavía
  PUBLISHED              // Visible al público
  HIDDEN_PENDING_REVIEW  // Flaggeado por IA o cliente; espera decisión admin
  HIDDEN_BY_ADMIN        // Ocultado manualmente por SUPER_ADMIN
}

enum AiModerationStatus {
  PENDING   // Esperando veredicto IA o retry
  OK        // IA aprobó
  FLAGGED   // IA rechazó (alguna categoría > threshold)
}

enum ConsentStatus {
  PENDING   // Token emitido, cliente aún no responde
  ACCEPTED  // Cliente confirmó, badge se enciende
  DECLINED  // Cliente rechazó, item sigue visible sin badge
  EXPIRED   // TTL agotado sin respuesta
}

enum ConsentDeclineReason {
  NOT_MINE      // No reconoce el trabajo
  INAPPROPRIATE // Contenido ofensivo o inadecuado
  INACCURATE    // Descripción / categoría no refleja lo hecho
  PRIVACY       // No quiere figurar aunque el trabajo sea real
  OTHER         // Texto libre opcional en declineNotes
}

enum ModerationTransitionType {
  INITIAL                       // Primera moderación del item
  RE_MODERATION                 // Re-moderación por edición de fotos/texto
  AUTO_RESTORE_AFTER_CORRECTION // Estaba HIDDEN, IA lo restauró sin intervención admin
  ADMIN_OVERRIDE                // Decisión manual del admin
}

// =============================================================================
// BLOQUE A — GEOGRAFÍA JERÁRQUICA
// Country → State (Departamento) → City (Localidad/Barrio)
// Propósito: filtros de UI, SEO de perfiles y escalabilidad regional.
// El matching de cercanía usa PostGIS en ServiceArea (y futuros puntos de trabajo).
// =============================================================================

/// Oficio (raíz) o servicio (hijo de un oficio).
enum CategoryType {
  TRADE
  SERVICE
}

enum GeoEntitySource {
  IDE
  GEONAMES
  GOOGLE
  MANUAL
  SEED
}

model Country {
  id      String  @id @default(uuid())
  name    String  @unique // Ej: "Uruguay"
  isoCode String  @unique // Ej: "UY" — ISO 3166-1 alpha-2
  slug    String  @unique // Ej: "uruguay"
  states  State[]
  professionalProfiles ProfessionalProfile[]
  companyBillingAddresses Company[] @relation("CompanyBillingCountry")
}

model State {
  id        String  @id @default(uuid())
  name      String  // Ej: "Montevideo", "Canelones", "Maldonado"
  slug      String
  countryId String
  iso3166_2 String? // Ej: "UY-MO"
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  source    GeoEntitySource @default(SEED)
  externalId String?
  country   Country @relation(fields: [countryId], references: [id])
  cities    City[]
  professionalProfiles ProfessionalProfile[]
  companyBillingAddresses Company[] @relation("CompanyBillingState")

  @@unique([countryId, name])
  @@unique([countryId, slug])
  @@index([countryId])
}

model City {
  id       String                @id @default(uuid())
  name     String                // Ej: "Pocitos", "Ciudad de la Costa"
  slug     String
  stateId  String
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  source    GeoEntitySource @default(SEED)
  externalId String?
  state    State                 @relation(fields: [stateId], references: [id])
  neighborhoods Neighborhood[]
  profiles ProfessionalProfile[]
  companyBillingAddresses Company[] @relation("CompanyBillingCity")

  @@unique([stateId, name])
  @@unique([stateId, slug])
  @@index([stateId])
}

model Neighborhood {
  id      String @id @default(uuid())
  name    String
  slug    String
  cityId  String
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  source    GeoEntitySource @default(SEED)
  externalId String?
  city    City   @relation(fields: [cityId], references: [id])
  profiles ProfessionalProfile[]
  companyBillingAddresses Company[] @relation("CompanyBillingNeighborhood")

  @@unique([cityId, name])
  @@unique([cityId, slug])
  @@index([cityId])
}

// =============================================================================
// BLOQUE B — IDENTIDAD Y EMPRESA
// =============================================================================

model User {
  id             String   @id @default(uuid())
  /// UID de Supabase Auth. Se extrae del JWT — nunca confiar en el body del request.
  supabaseUid    String   @unique
  email          String   @unique
  fullName       String
  role           Role     @default(CLIENT)
  /// Token de Expo Push Notifications. Se actualiza al iniciar sesión desde la app.
  expoPushToken  String?
  /// FK a Company — solo para usuarios con rol COMPANY_EMPLOYEE.
  companyId      String?
  company        Company? @relation("CompanyEmployees", fields: [companyId], references: [id])

  // Relaciones
  professionalProfile ProfessionalProfile?
  ownedCompany        Company?             @relation("CompanyAdmin")
  jobsAsClient        Job[]                @relation("JobClient")
  jobChangeOrdersProposed JobChangeOrder[] @relation("JobChangeOrderProposer")
  disputesAsClient    Dispute[]            @relation("DisputeClient")
  disputesAsPro       Dispute[]            @relation("DisputeProfessional")
  reviewsAsClient     Review[]             @relation("ReviewClient")
  reviewsAsPro        Review[]             @relation("ReviewProfessional")
  evidences           WorkEvidence[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  urgenciesAsClient   Urgency[]

  /// Soft Delete — nunca borrar físicamente. Usar update({ data: { deletedAt: new Date() } })
  deletedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
}

model Company {
  id      String  @id @default(uuid())
  name    String
  /// RUT uruguayo (Registro Único Tributario) — identificador fiscal obligatorio.
  rut     String  @unique
  /// Key S3/R2 del logo. Nunca URL directa — usar StorageService.generatePresignedGetUrl().
  logoKey String?
  tradeName String?
  legalName String?
  websiteUrl String?
  billingAddressLine String?
  taxId String?
  taxCondition String?
  billingCountryId String?
  billingStateId String?
  billingCityId String?
  billingNeighborhoodId String?
  billingCountry Country? @relation("CompanyBillingCountry", fields: [billingCountryId], references: [id])
  billingState State? @relation("CompanyBillingState", fields: [billingStateId], references: [id])
  billingCity City? @relation("CompanyBillingCity", fields: [billingCityId], references: [id])
  billingNeighborhood Neighborhood? @relation("CompanyBillingNeighborhood", fields: [billingNeighborhoodId], references: [id])

  /// El usuario COMPANY_ADMIN que administra esta empresa.
  adminId String @unique
  admin   User   @relation("CompanyAdmin", fields: [adminId], references: [id])

  // Relaciones
  employees User[]                @relation("CompanyEmployees")
  auditLogs AuditLog[]
  businessHours CompanyBusinessHour[]
  contacts CompanyContact[]
  trustProfiles TrustProfile[]

  dgiVerificationStatus DgiVerificationStatus @default(UNVERIFIED)
  dgiVerificationMethod String?
  dgiRazonSocial          String?
  dgiVerifiedAt           DateTime?             @db.Timestamptz
  dgiVerificationDocKey   String?

  subscriptionPlan   SubscriptionPlan @default(FREE)
  planDefinitionId   String
  planDefinition     PlanDefinition     @relation("CompanyPlan", fields: [planDefinitionId], references: [id])
  customPlanDefinition PlanDefinition?  @relation("CustomPlanCompany")
  serviceAreas         ServiceArea[]
  payoutAccounts       PayoutAccount[]
  billingSubscription  BillingSubscription?

  /// Vidriera / búsqueda (fase empresa buscable).
  bio           String?
  isAvailable   Boolean @default(false)
  averageRating Float   @default(0)

  categories CompanyCategory[]

  /// Soft Delete
  deletedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz

  @@index([planDefinitionId])
}

/// Zona de cobertura (punto + radio) de un profesional o empresa.
model ServiceArea {
  id String @id @default(uuid())

  professionalProfileId String?
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  label        String  @db.VarChar(100)
  addressLine  String?
  countryId        String?
  stateId          String?
  cityId           String?
  neighborhoodId   String?
  location     Unsupported("geography(Point, 4326)")
  radiusMeters Int     @default(5000)
  isPrimary    Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([professionalProfileId])
  @@index([companyId])
  @@index([location], type: Gist)
}

/// Catálogo de planes (FREE/PRO/BUSINESS) y planes CUSTOM 1:1 con pro o empresa.
model PlanDefinition {
  id           String           @id @default(uuid())
  code         SubscriptionPlan
  entitlements Json
  version      Int              @default(1)
  isActive     Boolean          @default(true)

  professionalProfileId String? @unique
  professionalProfile   ProfessionalProfile? @relation("CustomPlanProfessional", fields: [professionalProfileId], references: [id])
  companyId             String? @unique
  company               Company?             @relation("CustomPlanCompany", fields: [companyId], references: [id])

  professionalProfiles ProfessionalProfile[] @relation("ProfilePlan")
  companies            Company[]             @relation("CompanyPlan")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model ProfessionalProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  /// Ciudad administrativa para filtros de UI y SEO. Complementa la ubicación PostGIS.
  countryId String?
  country Country? @relation(fields: [countryId], references: [id])
  stateId String?
  state State? @relation(fields: [stateId], references: [id])
  cityId String?
  city   City?   @relation(fields: [cityId], references: [id])
  neighborhoodId String?
  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  addressLine String?

  /// Geo de cobertura: usar relación `serviceAreas` (ServiceArea). La columna `location` fue eliminada en fase 5.

  /// RUT uruguayo opcional (monotributo / unipersonal). Validación DGI en aplicación.
  rut              String?          @unique
  kycStatus        KycStatus        @default(UNVERIFIED)
  subscriptionPlan SubscriptionPlan @default(FREE)
  planDefinitionId String
  planDefinition   PlanDefinition   @relation("ProfilePlan", fields: [planDefinitionId], references: [id])
  customPlanDefinition PlanDefinition? @relation("CustomPlanProfessional")
  isAvailable      Boolean          @default(false)
  /// Rating promedio recalculado por ReviewService al validar cada reseña.
  averageRating    Float            @default(0)
  bio              String?
  /// Años de experiencia declarados por el profesional.
  experienceYears  Int?

  // Keys S3/R2 de documentos KYC — nunca URLs directas
  documentFrontKey String?
  documentBackKey  String?
  /// Key del documento de identidad (frente o único) tras flujo presign.
  identityCardKey  String?
  selfieKey        String?

  // Relaciones
  categories      ProfessionalCategory[]
  jobsAsPro       Job[]                  @relation("JobProfessional")
  urgencies       Urgency[]
  reviews         Review[]               @relation("ReviewProfessionalProfile")
  identity        ProfessionalIdentity?
  trustProfiles   TrustProfile[]
  certifications  ProfessionalCertification[]
  portfolioItems  PortfolioItem[]
  serviceAreas    ServiceArea[]
  payoutAccounts  PayoutAccount[]
  billingSubscription BillingSubscription?

  dgiVerificationStatus DgiVerificationStatus @default(UNVERIFIED)
  dgiVerificationMethod String?
  dgiRazonSocial          String?
  dgiVerifiedAt           DateTime?             @db.Timestamptz
  dgiVerificationDocKey   String?

  /// Soft Delete
  deletedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz

  @@index([planDefinitionId])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
  @@index([neighborhoodId])
}

/// Suscripción SaaS recurrente (Mercado Pago preapproval). Una fila activa por profesional o empresa.
model BillingSubscription {
  id                    String                    @id @default(uuid())
  professionalProfileId String?                   @unique
  professionalProfile   ProfessionalProfile?      @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  companyId             String?                   @unique
  company               Company?                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planCode              SubscriptionPlan
  status                SubscriptionBillingStatus
  trialEndsAt           DateTime?                 @db.Timestamptz
  currentPeriodStart    DateTime?                 @db.Timestamptz
  currentPeriodEnd      DateTime?                 @db.Timestamptz
  graceEndsAt           DateTime?                 @db.Timestamptz
  cancelAtPeriodEnd     Boolean                   @default(false)
  dunningReminderSent   Int                       @default(0)
  lastDunningAt         DateTime?                 @db.Timestamptz
  mpPreapprovalId       String?
  mpPreapprovalPlanId   String?
  externalReference     String                    @unique
  billingAmountUsdCents Int?
  billingAmountUyuCents Int?
  customAmountUsdCents  Int?
  exchangeRateId        String?
  exchangeRate          ExchangeRate?             @relation(fields: [exchangeRateId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([status])
  @@index([graceEndsAt])
  @@index([currentPeriodEnd])
}

model ProfessionalIdentity {
  id String @id @default(uuid())
  professionalProfileId String @unique
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id])
  phoneE164 String?
  whatsappE164 String?
  phoneVerifiedAt DateTime? @db.Timestamptz
  whatsappVerifiedAt DateTime? @db.Timestamptz
  instagramUrl String?
  facebookUrl String?
  linkedinUrl String?
  tiktokUrl String?
  websiteUrl String?
  maxTravelDistanceKm Int?
  profileImageKey String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
}

model CompanyBusinessHour {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  weekday Weekday
  opensAt String?
  closesAt String?
  isClosed Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([companyId, weekday])
  @@index([companyId, weekday])
}

model CompanyContact {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  channel String
  value String
  verifiedAt DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model TrustProfile {
  id String @id @default(uuid())
  subjectType VerificationSubjectType
  subjectId String
  status TrustStatus @default(PENDING)
  verificationLevel VerificationLevel @default(LEVEL_1)
  riskLevel String?
  verifiedAt DateTime? @db.Timestamptz
  suspendedAt DateTime? @db.Timestamptz
  suspensionReason String?
  professionalProfileId String?
  professionalProfile ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id])
  companyId String?
  company Company? @relation(fields: [companyId], references: [id])
  documents VerificationDocument[]
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([subjectType, subjectId])
  @@index([professionalProfileId])
  @@index([companyId])
}

model VerificationDocument {
  id String @id @default(uuid())
  trustProfileId String
  trustProfile TrustProfile @relation(fields: [trustProfileId], references: [id])
  documentType VerificationDocumentType
  storageKey String
  status VerificationDocumentStatus @default(PENDING)
  reviewedAt DateTime? @db.Timestamptz
  reviewedBy String?
  rejectionReason String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([trustProfileId, status])
}

model ProfessionalCertification {
  id String @id @default(uuid())
  professionalProfileId String
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id])
  title String
  issuer String?
  issuedAt DateTime? @db.Timestamptz
  expiresAt DateTime? @db.Timestamptz
  credentialId String?
  credentialUrl String?
  evidenceKey String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  @@index([professionalProfileId])
}

model Category {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique // Ej: "electricidad-urgencias"
  type            CategoryType @default(TRADE)
  supportsUrgency Boolean      @default(false)
  /// Auto-relación: TRADE (oficio) → SERVICE (servicio)
  parentId        String?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryHierarchy")

  professionals   ProfessionalCategory[]
  companies       CompanyCategory[]
  jobs            Job[]
  urgencies       Urgency[]
  portfolioItems  PortfolioItem[]

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
}

/// Tabla intermedia N-N entre Company y Category.
model CompanyCategory {
  companyId  String
  categoryId String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([companyId, categoryId])
}

/// Tabla intermedia N-N entre ProfessionalProfile y Category.
model ProfessionalCategory {
  professionalId String
  categoryId     String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  category       Category            @relation(fields: [categoryId], references: [id])

  @@id([professionalId, categoryId])
}

// =============================================================================
// BLOQUE C — TRABAJO Y CICLO FINANCIERO
// =============================================================================

model Currency {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  minorUnits    Int      @default(2)
  /// Código BCU (ej. USD = 2225). Null para moneda base UYU.
  bcuMonedaCode Int?
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  jobs          Job[]
  escrowJobCurrency EscrowTransaction[] @relation("EscrowJobCurrency")
  ratesAsBase   ExchangeRate[]          @relation("RateBaseCurrency")
  ratesAsQuote  ExchangeRate[]          @relation("RateQuoteCurrency")
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz
}

/// Tipo de cambio oficial (BCU). Par típico: base UYU, quote USD.
model ExchangeRate {
  id              String   @id @default(uuid())
  baseCurrencyId  String
  baseCurrency    Currency @relation("RateBaseCurrency", fields: [baseCurrencyId], references: [id])
  quoteCurrencyId String
  quoteCurrency   Currency @relation("RateQuoteCurrency", fields: [quoteCurrencyId], references: [id])
  effectiveDate   DateTime @db.Date
  /// UYU por 1 unidad de quote, × 1e6 (sin float).
  buyRateMicros   Int
  sellRateMicros  Int
  source          String   @default("BCU")
  escrows         EscrowTransaction[]
  billingSubscriptions BillingSubscription[]
  createdAt       DateTime @default(now()) @db.Timestamptz

  @@unique([baseCurrencyId, quoteCurrencyId, effectiveDate])
  @@index([quoteCurrencyId, effectiveDate(sort: Desc)])
}

model Job {
  id String @id @default(uuid())

  clientId String
  client   User   @relation("JobClient", fields: [clientId], references: [id])

  /// Asignado cuando un profesional acepta el trabajo. Null hasta entonces.
  professionalId String?
  professional   ProfessionalProfile? @relation("JobProfessional", fields: [professionalId], references: [id])

  /// Cuenta de cobro elegida al aceptar (snapshot lógico; escrow copia FK).
  payoutAccountId String?
  payoutAccount   PayoutAccount? @relation("JobPayoutAccount", fields: [payoutAccountId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id])

  status       JobStatus      @default(PENDING)
  pricingMode  JobPricingMode @default(FIXED)
  title        String
  description  String

  /// Total vigente en minor units de currencyId (suma líneas aprobadas + change orders).
  totalAmountCents Int

  addressLine      String?
  countryId        String?
  stateId          String?
  cityId           String?
  neighborhoodId   String?
  latitude         Float?
  longitude        Float?

  /// Timestamp cuando el profesional marcó el trabajo como COMPLETED.
  completedAt      DateTime? @db.Timestamptz
  /// Deadline de aceptación silenciosa: completedAt + 48hs hábiles (calculado con date-fns).
  approvalDeadline DateTime? @db.Timestamptz

  priceLines    JobPriceLine[]
  changeOrders  JobChangeOrder[]

  // Relaciones
  escrowTransaction EscrowTransaction?
  dispute           Dispute?
  review            Review?
  evidences         WorkEvidence[]
  urgency           Urgency?
  portfolioItem     PortfolioItem?

  /// Soft Delete — el historial de trabajos nunca se borra para proteger a ambas partes.
  deletedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
}

model JobPriceLine {
  id          String           @id @default(uuid())
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type        JobPriceLineType
  label       String
  amountCents Int
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now()) @db.Timestamptz

  @@index([jobId])
}

model JobChangeOrder {
  id           String               @id @default(uuid())
  jobId        String
  job          Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposedById String
  proposedBy   User                 @relation("JobChangeOrderProposer", fields: [proposedById], references: [id])
  status       JobChangeOrderStatus @default(PENDING)
  clientNote   String?
  lines        JobChangeOrderLine[]
  createdAt    DateTime             @default(now()) @db.Timestamptz
  updatedAt    DateTime             @updatedAt @db.Timestamptz

  @@index([jobId, status])
}

model JobChangeOrderLine {
  id            String           @id @default(uuid())
  changeOrderId String
  changeOrder   JobChangeOrder   @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  type          JobPriceLineType
  label         String
  amountCents   Int
  sortOrder     Int              @default(0)

  @@index([changeOrderId])
}

/// Núcleo financiero ACID. Toda mutación de esta tabla requiere prisma.$transaction().
/// Ver docs/explanation/escrow-logic.md para la State Machine completa.
model EscrowTransaction {
  id    String @id @default(uuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id])

  status EscrowStatus @default(PENDING)

  /// Moneda del contrato al fondear (copia de Job.currencyId).
  jobCurrencyId String?
  jobCurrency   Currency? @relation("EscrowJobCurrency", fields: [jobCurrencyId], references: [id])
  /// Monto en minor units de jobCurrency al fondear.
  jobAmountCents Int?
  /// Tasa BCU usada si jobCurrency es USD.
  exchangeRateId String?
  exchangeRate   ExchangeRate? @relation(fields: [exchangeRateId], references: [id])

  /// Monto retenido en centavos UYU (liquidación / pasarela).
  amountCents Int
  /// Comisión de HRProgrammers en centavos. Calculado al fondear.
  commissionCents Int @default(0)
  /// Monto neto que recibirá el profesional: amountCents - commissionCents.
  netAmountCents Int @default(0)

  /// ID del Job de BullMQ del timer de aceptación silenciosa (48hs).
  /// Se usa para cancelarlo si el cliente abre una disputa antes del deadline.
  bullJobId String?

  /// Referencia interna de la pasarela de pagos uruguaya (ej. RedPagos, Mercado Pago UY).
  providerReference String?
  /// URL externa de seguimiento o comprobante de la pasarela de pagos.
  externalUrl       String?

  /// Snapshot de destino de cobro al aceptar/fondear.
  payoutAccountId String?
  payoutAccount   PayoutAccount? @relation("EscrowPayoutAccount", fields: [payoutAccountId], references: [id])

  payoutStatus EscrowPayoutStatus @default(NOT_APPLICABLE)

  releasedAt DateTime? @db.Timestamptz
  refundedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  auditLogs      AuditLog[]
  payoutAttempts PayoutAttempt[]
}

/// Catálogo de bancos uruguayos para destino BANK.
model Bank {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  bcuPrefix String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  payoutAccounts PayoutAccount[]
}

/// Destino de cobro del profesional o empresa (N por sujeto).
model PayoutAccount {
  id          String @id @default(uuid())
  subjectType PayoutSubjectType
  method      PayoutMethod
  label       String
  isPrimary   Boolean @default(false)
  isActive    Boolean @default(true)

  professionalProfileId String?
  professionalProfile   ProfessionalProfile? @relation(fields: [professionalProfileId], references: [id])
  companyId             String?
  company               Company?             @relation(fields: [companyId], references: [id])

  identifierType     PayoutIdentifierType
  transferIdentifier String?
  mpAlias            String?
  accountHolderName  String?
  bankId             String?
  bank               Bank?   @relation(fields: [bankId], references: [id])

  verifiedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  jobsAsPayout     Job[]              @relation("JobPayoutAccount")
  escrowsAsPayout  EscrowTransaction[] @relation("EscrowPayoutAccount")
  payoutAttempts   PayoutAttempt[]

  @@index([subjectType, professionalProfileId])
  @@index([subjectType, companyId])
}

/// Ledger inmutable de intentos de payout al profesional.
model PayoutAttempt {
  id                  String @id @default(uuid())
  escrowTransactionId String
  escrowTransaction   EscrowTransaction @relation(fields: [escrowTransactionId], references: [id])
  payoutAccountId     String
  payoutAccount       PayoutAccount @relation(fields: [payoutAccountId], references: [id])

  attemptNumber Int
  status        PayoutAttemptStatus @default(PENDING)
  amountCents   Int
  netAmountCents Int

  destinationSnapshot Json
  providerReference   String?
  providerStatus      String?
  failureCode         String?
  failureMessage      String?
  /// Comprobante de transferencia manual (S3/R2); obligatorio en confirmación ADMIN_MANUAL.
  receiptStorageKey   String?
  adminPayoutNote     String?

  triggeredBy         PayoutAttemptTrigger
  triggeredByUserId   String?

  createdAt   DateTime  @default(now()) @db.Timestamptz
  completedAt DateTime? @db.Timestamptz

  @@unique([escrowTransactionId, attemptNumber])
  @@index([status, createdAt])
}

model Urgency {
  id String @id @default(uuid())

  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  /// Profesional que aceptó. Null hasta la asignación.
  professionalId String?
  professional   ProfessionalProfile? @relation(fields: [professionalId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  jobId String? @unique
  job   Job?    @relation(fields: [jobId], references: [id])

  status UrgencyStatus @default(BROADCAST)

  /// Coordenadas del cliente en el momento de despachar la urgencia.
  clientLat Float
  clientLng Float

  description String
  /// Presupuesto estimado en centavos. Opcional — puede no conocerse al despachar.
  estimatedBudgetCents Int?

  /// ID del Job padre de BullMQ del Weighted Broadcast.
  /// Se usa para cancelar los Jobs hijos cuando alguien acepta.
  bullJobId String?

  /// Deadline antes de marcar la urgencia como EXPIRED (configurable, default 30min).
  expiresAt  DateTime  @db.Timestamptz
  acceptedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz
}

// =============================================================================
// BLOQUE D — CONFIANZA, DISPUTAS Y RESEÑAS
// =============================================================================

model Dispute {
  id    String @id @default(uuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id])

  clientId String
  client   User   @relation("DisputeClient", fields: [clientId], references: [id])

  professionalId String
  professional   User   @relation("DisputeProfessional", fields: [professionalId], references: [id])

  status DisputeStatus @default(OPEN)
  /// Motivo de la disputa. DisputeReason enum definido en código (src/common/enums/).
  reason      String
  description String
  /// Notas del SUPER_ADMIN al resolver. Obligatorio para trazabilidad de decisiones humanas.
  adminNotes  String?

  /// Deadline de la Segunda Oportunidad: +48hs hábiles desde activación.
  secondChanceDeadline DateTime? @db.Timestamptz
  resolvedAt           DateTime? @db.Timestamptz
  createdAt            DateTime  @default(now()) @db.Timestamptz
  updatedAt            DateTime  @updatedAt @db.Timestamptz

  evidences WorkEvidence[]
}

/// Evidencia de un trabajo. Inmutable por diseño — no tiene Soft Delete.
/// El uploadedAt es generado por la DB, nunca por el código de aplicación ni el cliente.
model WorkEvidence {
  id String @id @default(uuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  /// Vinculada a una disputa si fue subida durante el proceso de mediación.
  disputeId String?
  dispute   Dispute? @relation(fields: [disputeId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  type EvidenceType
  /// Key S3/R2 del archivo. Nunca URL directa.
  /// Usar StorageService.generatePresignedGetUrl(fileKey, bucket) para visualizar.
  fileKey     String
  description String?
  /// true si fue subida DESPUÉS de abrir la disputa → no reconocida en mediación.
  lateEvidence Boolean @default(false)

  /// Generado por PostgreSQL DEFAULT NOW(). Crítico para la Regla de Evidencia Proactiva.
  uploadedAt DateTime @default(now()) @db.Timestamptz

  @@index([jobId, type])
}

model Review {
  id    String @id @default(uuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id])

  clientId String
  client   User   @relation("ReviewClient", fields: [clientId], references: [id])

  professionalId String
  professional   User   @relation("ReviewProfessional", fields: [professionalId], references: [id])

  professionalProfileId String
  professionalProfile   ProfessionalProfile @relation("ReviewProfessionalProfile", fields: [professionalProfileId], references: [id])

  status ReviewStatus @default(PENDING_PHOTOS)

  /// Dimensión 1: puntualidad del profesional. Rango 1-5 (entero).
  punctualityScore   Int
  /// Dimensión 2: calidad y prolijidad del trabajo. Rango 1-5 (entero).
  qualityScore       Int
  /// Dimensión 3: relación precio/resultado. Rango 1-5 (entero).
  valueForMoneyScore Int
  /// Promedio calculado en ReviewService: AVG(punctuality, quality, value). Nunca ingresado por el cliente.
  overallScore       Float

  comment String

  /// Keys S3/R2 de las fotos. Obligatorias para pasar de PENDING_PHOTOS a VALIDATED.
  beforePhotoKey String?
  afterPhotoKey  String?

  /// Soft Delete — el historial de reseñas es propiedad de los clientes que las escribieron.
  deletedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
}

// =============================================================================
// BLOQUE E — AUDITORÍA UNIVERSAL Y NOTIFICACIONES
// =============================================================================

/// Registro inmutable de todas las acciones críticas del sistema.
/// Cubre: pagos, cambios de roles, estados de trabajos y acciones de empleados.
/// No tiene Soft Delete — es inmutable por diseño legal y de trazabilidad.
model AuditLog {
  id String @id @default(uuid())

  /// Usuario que ejecutó la acción. Puede ser un usuario de sistema (BullMQ worker).
  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// FK opcional a Company. Permite al COMPANY_ADMIN auditar las acciones de sus empleados.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  /// Escrow vinculado (si la acción afecta un pago).
  escrowTransactionId String?
  escrowTransaction   EscrowTransaction? @relation(fields: [escrowTransactionId], references: [id])

  action AuditAction

  /// Nombre de la tabla afectada. Ej: "EscrowTransaction", "User", "Job".
  entityType String
  /// UUID de la fila afectada. Indexado para consultas de auditoría por entidad.
  entityId   String

  /// Estado anterior serializado como JSON string.
  previousState String?
  /// Estado nuevo serializado como JSON string.
  newState      String?

  /// Datos adicionales contextuales. Ej: { adminNotes, fromRole, toRole, reason }.
  metadata Json?

  /// Dirección IP del cliente que originó la acción. Crítico para cambios de rol y finanzas.
  ipAddress String?
  /// User-Agent del cliente para trazabilidad de seguridad.
  userAgent String?

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([entityId])
  @@index([companyId])
  @@index([userId])
}

/// Historial persistente de notificaciones en-app (la campana).
/// Permite al usuario ver lo que pasó mientras estaba desconectado.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type    NotificationType
  title   String
  message String

  /// Tipo de entidad relacionada para deep linking. Ej: "Job", "Dispute", "Urgency".
  relatedEntityType String?
  /// UUID de la entidad relacionada. La app navega a ella al tocar la notificación.
  relatedEntityId   String?

  /// null = no leída. Indexado junto con userId para la query de "no leídas".
  readAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId, readAt])
}

// =============================================================================
// BLOQUE F — PORTFOLIO DEL PROFESIONAL
// Vidriera pública de trabajos realizados. Distinto de WorkEvidence (forense para
// disputas) y de Review (post-transacción). Ver .harness/specs/portfolio-module.md.
// =============================================================================

/// Item del portfolio del profesional. Puede estar vinculado opcionalmente a un
/// Job CLOSED del mismo profesional para obtener el badge "Verificado".
/// Una vez verifiedFromJob = true, jobId y categoryId son INMUTABLES
/// (trigger portfolio_item_freeze_after_verification_trg + guard en Service).
model PortfolioItem {
  id             String  @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  title       String  // 3-100 chars, validado en DTO
  description String  // 10-2000 chars, validado en DTO
  status      PortfolioItemStatus @default(DRAFT)

  /// Vínculo opcional con un Job CLOSED del mismo profesional.
  /// Si está seteado: job.professionalId === professionalId, job.status === CLOSED,
  /// job.categoryId === categoryId.
  jobId String? @unique
  job   Job?    @relation(fields: [jobId], references: [id])

  /// true solo si existe PortfolioConsent ACCEPTED para este item.
  /// Una vez true, jobId y categoryId son INMUTABLES (trigger DB + guard Service).
  verifiedFromJob Boolean @default(false)

  // Snapshot del último veredicto de moderación IA
  aiModerationStatus   AiModerationStatus @default(PENDING)
  /// Razón legible: nsfw | watermark | brand_violation | unrelated | provider_unavailable
  aiModerationReason   String?
  /// Identificador del modelo que realizó la moderación. Formato: vendor:model:version
  /// Regex: ^[a-z0-9_]+:[a-z0-9_-]+:[a-z0-9._-]+$ — validado por ModerationModelRef helper.
  aiModerationModelRef String?
  aiModeratedAt        DateTime? @db.Timestamptz

  publishedAt DateTime? @db.Timestamptz
  /// Seteado por el processor portfolio-cleanup tras borrar archivos de R2/Redis.
  cleanedUpAt DateTime? @db.Timestamptz
  /// Soft Delete — usar update({ data: { deletedAt: new Date() } }).
  deletedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  photos         PortfolioPhoto[]
  consent        PortfolioConsent?
  moderationLogs PortfolioModerationLog[]

  @@index([professionalId, status])
  @@index([categoryId, status])
  @@index([aiModerationModelRef, aiModeratedAt])
}

/// Foto individual de un PortfolioItem. displayOrder es siempre compacto (1..N sin huecos).
/// El re-orden automático al borrar/insertar debe ocurrir en la misma prisma.$transaction().
model PortfolioPhoto {
  id              String        @id @default(uuid())
  portfolioItemId String
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id])

  /// Key R2/S3 con naming canónico: users/<professionalId>/portfolio/<itemId>/<uuid>.<ext>
  /// Único globalmente para evitar colisiones de caché vs delete.
  /// Construido y validado por src/modules/storage/storage-paths.ts.
  fileKey      String  @unique
  caption      String?
  /// Orden 1..N sin huecos. Re-orden atómico en transacción al borrar/insertar.
  displayOrder Int
  /// Seteado a true por el processor portfolio-moderate si la IA flagea esta foto específica.
  aiFlagged    Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([portfolioItemId, displayOrder])
}

/// Flujo de consentimiento del cliente para el badge de verificación.
/// El token es de un solo uso, enviado por email/push al cliente del Job vinculado.
model PortfolioConsent {
  id              String        @id @default(uuid())
  portfolioItemId String        @unique
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id])

  jobId        String
  clientUserId String

  /// UUID v4 de un solo uso. Enviado al cliente por email/push para autenticarse.
  token String @unique

  status        ConsentStatus        @default(PENDING)
  declineReason ConsentDeclineReason?
  /// Texto libre opcional al declinar. Sanitizado por PiiSanitizer. Max 500 chars.
  declineNotes  String?

  requestedAt DateTime @default(now()) @db.Timestamptz
  /// Sello del INTENTO de envío del recordatorio (claim del lock de outbox).
  reminderAttemptedAt DateTime? @db.Timestamptz
  /// Sello de CONFIRMACIÓN del envío (provider devolvió OK con messageId).
  reminderSentAt  DateTime? @db.Timestamptz
  respondedAt     DateTime? @db.Timestamptz
  /// TTL configurable. Default: requestedAt + 14 días (PORTFOLIO_CONSENT_TTL_DAYS).
  expiresAt       DateTime  @db.Timestamptz

  @@index([status, expiresAt])
}

/// Registro append-only de cada moderación IA sobre un PortfolioItem.
/// Permite auditar qué modelo tomó cada decisión y comparar tras cambios de proveedor.
/// NUNCA persiste texto libre del proveedor de IA — solo categorías + scores numéricos.
model PortfolioModerationLog {
  id              String        @id @default(uuid())
  portfolioItemId String
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id])

  /// Identificador del modelo que moderó. Formato: vendor:model:version
  modelRef String

  transitionType ModerationTransitionType
  /// OK | FLAGGED | ERROR
  status  String
  /// Categoría de rechazo: nsfw | watermark | brand_violation | unrelated
  reason  String?

  /// JSON estructurado con categorías y scores numéricos.
  /// Ejemplo: { "nsfw": 0.02, "violence": 0.01, "brand_violation": 0.71 }
  /// NUNCA texto libre del proveedor (evita PII colateral).
  scores Json?

  /// Solo cuando status = ERROR. Sanitizado por PiiSanitizer antes de persistir.
  errorCode    String?
  /// Max 1000 chars. Sanitizado (sin emails, teléfonos, cédulas, IBAN, URLs con tokens).
  errorMessage String?
  /// Latencia del call al proveedor en milisegundos. Para monitoreo del SLO.
  latencyMs    Int?

  /// Versión de la política de moderación activa en el momento de la decisión.
  /// Permite auditoría retrospectiva: saber bajo qué reglas se aprobó un contenido.
  /// Formato libre sugerido: semver o fecha YYYY-MM-DD. Ej: "1.0.0", "2026-05-13".
  policyVersion String?

  scoredAt DateTime @default(now()) @db.Timestamptz

  @@index([portfolioItemId, scoredAt])
  @@index([modelRef, scoredAt])
}

/// Caché de resultados de inferencia IA por hash de contenido.
/// Evita llamar al proveedor externo cuando el mismo contenido ya fue analizado.
/// Propiedad de AiModule; accesible por cualquier dominio (Portfolio, WorkEvidence, etc.).
model AiInferenceCache {
  id          String @id @default(uuid())

  /// Tipo de tarea IA. Forma parte de la clave de caché para evitar colisiones cross-taskType.
  /// Ejemplos: "IMAGE_SAFETY_V1", "TEXT_MODERATION_V1"
  taskType    String

  /// SHA-256 del contenido ORIGINAL (imagen completa en bytes, o texto normalizado).
  /// NUNCA el hash del thumbnail generado por sharp.
  contentHash String

  /// Versión de la política de moderación con la que se calculó este resultado.
  /// La caché debe invalidarse (o ignorarse en lookup) cuando policyVersion cambie.
  policyVersion String

  /// Referencia al modelo que produjo el resultado. Formato: vendor:model:version
  modelRef    String

  /// JSON sanitizado con el resultado (scores/categorías). Sin PII ni texto crudo del proveedor.
  resultJson  Json

  /// Módulo de origen (solo métricas, no forma parte de la clave de deduplicación).
  sourceModule String?

  /// Número de veces que este resultado fue reutilizado desde caché.
  /// Permite calcular ahorro en USD en reportes mensuales.
  hitsCount   Int @default(0)

  expiresAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  /// Clave única de deduplicación: taskType + contentHash + policyVersion
  @@unique([taskType, contentHash, policyVersion])
  @@index([taskType, contentHash, policyVersion])
  @@index([expiresAt])
}
