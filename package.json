{
  "name": "nexos-backend",
  "version": "0.0.1",
  "description": "Nexos backend — HRProgrammers. Ver src/config/vitest.config.ts y src/config/vitest.e2e.config.ts para tests.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run --config src/config/vitest.config.ts",
    "test:watch": "vitest --config src/config/vitest.config.ts",
    "test:cov": "vitest run --config src/config/vitest.config.ts --coverage",
    "test:cov:strict": "vitest run --config src/config/vitest.config.ts --coverage",
    "test:cov:billing": "vitest run --config src/config/vitest.billing.config.ts --coverage",
    "test:e2e": "vitest run --config src/config/vitest.e2e.config.ts",
    "test:all": "npm run test && npm run test:e2e",
    "db:generate": "prisma generate --config prisma/prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma/prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma/prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma/prisma.config.ts",
    "db:migrate:reset": "prisma migrate reset --config prisma/prisma.config.ts",
    "db:push": "prisma db push --config prisma/prisma.config.ts",
    "db:studio": "prisma studio --config prisma/prisma.config.ts",
    "db:seed": "node prisma/seed.js",
    "db:seed:geo": "node prisma/seed.geo.js",
    "geo:build": "node scripts/build-uruguay-geo.mjs",
    "categories:build": "node scripts/build-categories-json.mjs",
    "db:seed:categories": "node prisma/seed.categories.js",
    "db:seed:demo": "node prisma/seed.demo.js",
    "db:seed:currencies": "node prisma/seed.currencies.js",
    "db:seed:banks": "node prisma/seed.banks.js",
    "db:seed:all": "npm run db:seed && npm run db:seed:geo && npm run db:seed:categories && npm run db:seed:currencies && npm run db:seed:banks && npm run db:seed:demo",
    "db:seed:stress": "SEED_STRESS=1 STRESS_PRO_COUNT=500 node prisma/seed.js",
    "db:backfill:trust-identity": "node prisma/backfill.trust-identity.js",
    "architecture:check": "node scripts/architecture-check.mjs",
    "quality:check": "npx tsc --noEmit && npm run lint && npm run architecture:check && npm run test:cov:strict && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1045.0",
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/s3-request-presigner": "^3.1044.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nestjs": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "bullmq": "^5.76.8",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.2.1",
    "date-fns-tz": "^3.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsqr": "^1.4.0",
    "jwks-rsa": "^4.0.1",
    "mercadopago": "^2.13.0",
    "nestjs-pino": "^4.6.1",
    "openai": "^6.37.0",
    "opossum": "^9.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pdf-to-png-converter": "^4.0.0",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@testcontainers/mongodb": "^11.14.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/express": "^5.0.0",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/opossum": "^8.1.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fishery": "^2.4.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^11.14.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
