# =============================================================================
# NEXOS BACKEND — Variables de Entorno para TESTS
# HRProgrammers
#
# Este archivo es usado por los tests de integración (*.e2e-spec.ts)
# con Testcontainers.
#
# IMPORTANTE:
# - Las variables DATABASE_URL, REDIS_URL y MONGODB_URI son SOBREESCRITAS
#   automáticamente por test/setup/global-setup.ts con las URLs de los
#   containers que levanta Testcontainers. Los valores aquí son fallbacks
#   y no se usan en la práctica para e2e tests.
# - Este archivo SÍ puede commitarse al repositorio (no contiene secrets reales).
# - Para tests unitarios, estas variables no se usan (deps están mockeadas).
# =============================================================================

NODE_ENV=test
PORT=3001

# -----------------------------------------------------------------------------
# TESTCONTAINERS — Imágenes Docker
# Controlan qué imagen se descarga al arrancar los containers.
# Deben coincidir con las imágenes en docker-compose.yml (entornos idénticos).
# -----------------------------------------------------------------------------

# Imagen de PostgreSQL con PostGIS para tests de integración.
# DEBE incluir PostGIS para las queries geoespaciales de ST_DWithin.
TESTCONTAINERS_POSTGRES_IMAGE=postgis/postgis:16-3.4

# Imagen de Redis para tests de integración.
TESTCONTAINERS_REDIS_IMAGE=redis:7-alpine

# Imagen de MongoDB para tests de integración.
TESTCONTAINERS_MONGO_IMAGE=mongo:7

# Timeout en segundos para que Testcontainers espere a que un container esté healthy.
TESTCONTAINERS_STARTUP_TIMEOUT=60

# -----------------------------------------------------------------------------
# FALLBACKS de conexión (sobreescritos por global-setup.ts en e2e tests)
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://nexos_test:nexos_test_password@localhost:5433/nexos_test
REDIS_URL=redis://:nexos_test_redis@localhost:6380
MONGODB_URI=mongodb://localhost:27018/nexos_test_chats

# -----------------------------------------------------------------------------
# SUPABASE AUTH (mock para tests — no usar keys de producción)
# En tests unitarios, el SupabaseGuard está mockeado directamente.
# En tests e2e, se usa este JWT_SECRET para firmar tokens de test.
# -----------------------------------------------------------------------------

SUPABASE_URL=https://mock-project.supabase.co
SUPABASE_ANON_KEY=mock-anon-key-for-testing-only
SUPABASE_JWT_SECRET=mock-jwt-secret-for-testing-only-not-for-production

# -----------------------------------------------------------------------------
# CONSTANTES DE NEGOCIO (valores fijos para tests predecibles)
# Usar valores pequeños para que los tests no dependan de tiempos largos.
# -----------------------------------------------------------------------------

# Días hábiles para aceptación silenciosa (igual que producción: 2)
ESCROW_SILENT_ACCEPTANCE_BUSINESS_DAYS=2

# Comisión de la plataforma (igual que producción: 10%)
ESCROW_COMMISSION_PERCENT=10

# Radio de búsqueda para urgencias en metros
URGENCY_RADIUS_METERS=7000

# Tiempo de expiración de urgencias (reducido para tests más rápidos)
URGENCY_EXPIRY_MINUTES=1

# Delays del Weighted Broadcast (reducidos a 0 para tests rápidos)
URGENCY_BROADCAST_DELAY_BUSINESS_MS=0
URGENCY_BROADCAST_DELAY_MEDIUM_MS=0
URGENCY_BROADCAST_DELAY_FREE_MS=0

# Cleanup de Escrows PENDING (reducido para tests)
ESCROW_PENDING_CLEANUP_HOURS=1

# TTL de Idempotency-Keys de Escrow en segundos (reducido para tests)
ESCROW_IDEMPOTENCY_TTL=60

# TTL del caché de categorías en Redis (reducido para tests)
CATEGORY_CACHE_TTL=10

# TTL de URLs firmadas de almacenamiento (en segundos)
STORAGE_PRESIGNED_URL_TTL=900

# -----------------------------------------------------------------------------
# SISTEMA — UUID del usuario sistema para BullMQ Workers
# En tests, se crea este usuario en el seed del e2e-setup.ts
# -----------------------------------------------------------------------------

SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001

# -----------------------------------------------------------------------------
# SERVICIOS EXTERNOS (mocks — no se usan en tests unitarios)
# En tests e2e que necesiten llamadas reales, reemplazar con valores válidos.
# -----------------------------------------------------------------------------

PAYMENT_GATEWAY_WEBHOOK_SECRET=mock-webhook-secret-testing
EXPO_ACCESS_TOKEN=mock-expo-token-testing
KYC_PROVIDER_API_KEY=mock-kyc-key-testing
KYC_PROVIDER_BASE_URL=https://mock-kyc-provider.test

SENTRY_DSN=
LOG_LEVEL=error
