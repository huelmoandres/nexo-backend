                "url": "{{baseUrl}}/api/portfolio/items/{{itemId}}",
                "description": "Soft-delete del item. Solo el dueño puede eliminar."
              }
            }
          ]
        },
        {
          "name": "Photos",
          "item": [
            {
              "name": "Presign foto",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  pm.environment.set('photoKey', body.key);",
                      "  pm.environment.set('uploadUrl', body.uploadUrl);",
                      "  pm.test('Presign OK', () => {",
                      "    pm.expect(body.uploadUrl).to.include('r2.cloudflarestorage.com');",
                      "    pm.expect(body.key).to.be.a('string');",
                      "  });",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fileExtension\": \"jpg\",\n  \"caption\": \"Vista frontal del trabajo terminado\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{baseUrl}}/api/portfolio/items/{{itemId}}/photos/presign",
                "description": "Genera URL firmada (PUT) para subir foto a R2. fileExtension: jpg|jpeg|png|webp. La URL expira en 15 min."
              }
            },
            {
              "name": "Registrar foto",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const body = pm.response.json();",
                      "  pm.environment.set('photoId', body.id);",
                      "  pm.test('Foto registrada', () => pm.expect(body.id).to.be.a('string'));",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fileKey\": \"{{photoKey}}\",\n  \"caption\": \"Vista frontal del trabajo terminado\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{baseUrl}}/api/portfolio/items/{{itemId}}/photos",
                "description": "Registra una foto ya subida a R2. fileKey debe ser la key devuelta por presign. displayOrder opcional."
              }
            },
            {
              "name": "Eliminar foto",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{baseUrl}}/api/portfolio/items/{{itemId}}/photos/{{photoId}}",
                "description": "Elimina foto del item. Solo el dueño puede eliminar. Reordena displayOrder automáticamente."
              }
            }
          ]
        },
        {
          "name": "Publish & Verify",
          "item": [
            {
              "name": "Publicar item",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/api/portfolio/items/{{itemId}}/publish",
                "description": "Publica el item. Verifica que TODAS las fotos existan en R2. Si AI moderation está activa, pasa a HIDDEN_PENDING_REVIEW."
              }
            },
            {
              "name": "Solicitar verificación",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/api/portfolio/items/{{itemId}}/request-verification",
                "description": "Solicita verificación del item al cliente del job vinculado. Requiere jobId en el item y job CLOSED."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Portfolio Consent",
      "description": "Flujo de consentimiento de verificación. Endpoints públicos (token en URL).",
      "item": [
        {
          "name": "Preview consentimiento (público)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/portfolio/consents/{{consentToken}}",
            "description": "Preview del consentimiento. El cliente accede con el token recibido por email."
          }
        },
        {
          "name": "Aceptar verificación (público)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/portfolio/consents/{{consentToken}}/accept",
            "description": "El cliente acepta la verificación del trabajo."
          }
        },
        {
          "name": "Rechazar verificación (público)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"INACCURATE\",\n  \"notes\": \"El trabajo mostrado no corresponde con lo realizado.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/portfolio/consents/{{consentToken}}/decline",
            "description": "El cliente rechaza la verificación. reason: NOT_MINE | INAPPROPRIATE | INACCURATE | PRIVACY | OTHER. notes opcional (max 500)."
          }
        }
      ]
    },
    {
      "name": "Portfolio Moderation",
      "description": "Moderación de items. Queue y moderate requieren SUPER_ADMIN. Report cualquier usuario autenticado.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Cambiar a token admin para requests de moderación",
              "const currentEmail = pm.environment.get('current_email');",
              "const adminEmail = pm.environment.get('admin_email');",
              "if (currentEmail !== adminEmail) {",
              "  pm.environment.set('current_email', adminEmail);",
              "  pm.environment.set('current_uid', pm.environment.get('admin_uid'));",
              "  pm.environment.unset('access_token');",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Cola de moderación (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/portfolio/moderation/queue?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "portfolio", "moderation", "queue"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            },
            "description": "Lista items pendientes de moderación. Requiere SUPER_ADMIN."
          }
        },
        {
          "name": "Aprobar item (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\",\n  \"reason\": \"Contenido verificado manualmente.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/portfolio/items/{{itemId}}/moderate",
            "description": "Aprueba un item. Pasa a PUBLISHED. Requiere SUPER_ADMIN. action: approve | hide."
          }
        },
        {
          "name": "Reportar item",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Reportar se hace como usuario normal, no admin",
                  "pm.environment.set('current_email', 'demo.client@nexos.local');",
                  "pm.environment.set('current_uid', '00000000-0000-4000-8000-000000000003');",
                  "pm.environment.unset('access_token');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/portfolio/items/{{itemId}}/report",
            "description": "Reporta un item PUBLISHED. Cualquier usuario autenticado excepto el dueño. Pasa a HIDDEN_PENDING_REVIEW."
          }
        }
      ]
    },
    {
      "name": "Portfolio Public",
      "description": "Vidriera pública del portfolio por profesional.",
      "item": [
        {
          "name": "Portfolio de profesional (público)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/professionals/{{professionalId}}/portfolio?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "professionals", "{{professionalId}}", "portfolio"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "categoryId", "value": "", "description": "Filtrar por categoría", "disabled": true },
                { "key": "verifiedOnly", "value": "true", "description": "Solo items verificados", "disabled": true }
              ]
            },
            "description": "Lista pública del portfolio de un profesional. Solo items PUBLISHED. Filtros opcionales: categoryId, verifiedOnly, paginación."
          }
        }
      ]
    }
  ]
}
