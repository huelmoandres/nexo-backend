{
  "info": {
    "name": "Nexos API",
    "_postman_id": "nexos-api-collection-v1",
    "description": "Colección completa de la API Nexos Backend.\n\nEl pre-request script a nivel de colección auto-genera un JWT via GET /api/auth/dev-token (solo en desarrollo). Para cambiar de usuario, modificar `current_email` y `current_uid` en el environment y limpiar `access_token`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-token: genera JWT via /api/auth/dev-token si no hay token válido.",
          "// Solo funciona en desarrollo (NODE_ENV !== 'production').",
          "// Si skip_auto_token está seteado (post-logout), no regenerar.",
          "",
          "const noAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (noAuth) return;",
          "",
          "if (pm.environment.get('skip_auto_token') === 'true') return;",
          "",
          "const token = pm.environment.get('access_token');",
          "const exp = parseInt(pm.environment.get('token_exp') || '0');",
          "",
          "if (token && Date.now() < exp) return;",
          "",
          "const email = pm.environment.get('current_email') || 'demo.pro@nexos.local';",
          "const uid = pm.environment.get('current_uid') || '00000000-0000-4000-8000-000000000002';",
          "const base = pm.environment.get('baseUrl') || 'http://localhost:3000';",
          "",
          "pm.sendRequest({",
          "  url: `${base}/api/auth/dev-token?email=${encodeURIComponent(email)}&uid=${encodeURIComponent(uid)}`,",
          "  method: 'GET'",
          "}, (err, res) => {",
          "  if (err) { console.error('Auto-token failed:', err); return; }",
          "  const body = res.json();",
          "  if (body.token) {",
          "    pm.environment.set('access_token', body.token);",
          "    pm.environment.set('token_exp', (Date.now() + 3500000).toString());",
          "  }",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Probes de liveness y readiness. No requieren autenticación.",
      "item": [
        {
          "name": "Liveness probe",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live",
            "description": "Responde 200 si el proceso está vivo."
          }
        },
        {
          "name": "Readiness probe",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready",
            "description": "Verifica conectividad con Postgres, Redis, Supabase JWT, Sentry y R2."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Autenticación y gestión de sesión.",
      "item": [
        {
          "name": "[DEV] Generar token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/dev-token?email={{current_email}}&uid={{current_uid}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "dev-token"],
              "query": [
                { "key": "email", "value": "{{current_email}}", "description": "Email del usuario" },
                { "key": "uid", "value": "{{current_uid}}", "description": "Supabase UID" }
              ]
            },
            "description": "Genera un JWT HS256 firmado con SUPABASE_JWT_SECRET. Solo disponible en desarrollo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('access_token', body.token);",
                  "  pm.environment.set('token_exp', (Date.now() + 3500000).toString());",
                  "  pm.environment.unset('skip_auto_token');",
                  "  pm.test('Token generado', () => pm.expect(body.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Sync usuario (JIT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{current_email}}\",\n  \"fullName\": \"Profesional Demo Nexos\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/sync",
            "description": "Sincroniza usuario de Supabase con PostgreSQL. Crea si no existe (rol CLIENT), retorna si ya existe. Body: email (debe coincidir con JWT) y fullName (min 3 chars)."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Invalida el token actual en la blocklist de Redis."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.environment.unset('access_token');",
                  "  pm.environment.unset('token_exp');",
                  "  pm.environment.set('skip_auto_token', 'true');",
                  "  pm.test('Sesión invalidada — skip_auto_token activado', () => {",
                  "    pm.expect(pm.environment.get('access_token')).to.be.undefined;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
