# =============================================================================
# NEXOS BACKEND — Variables de Entorno
# HRProgrammers
#
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.example .env
#   2. Completar todos los valores marcados con <REEMPLAZAR>
#   3. Nunca commitear el archivo .env (ya está en .gitignore)
#
# VALORES POR DEFECTO (solo para desarrollo local con docker-compose):
#   Los valores que coinciden con docker-compose.yml ya están pre-completados.
#   En staging/producción, TODOS los valores deben reemplazarse con secrets reales.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVIDOR
# -----------------------------------------------------------------------------

NODE_ENV=development
# NODE_ENV=staging
# NODE_ENV=production

PORT=3000

# -----------------------------------------------------------------------------
# API — Problem Details (RFC 7807)
# Base del campo `type` en respuestas de error (sin barra final).
# Documentación de slugs: docs/reference/api-standards.md
# En staging/producción puede apuntar a un dominio de docs real.
# -----------------------------------------------------------------------------
# PROBLEM_DETAIL_TYPE_BASE_URL=https://nexos.com/errors

# -----------------------------------------------------------------------------
# POSTGRESQL + POSTGIS (núcleo financiero ACID)
# Debe coincidir con los valores de docker-compose.yml
# Incluye los parámetros de conexión y pool para Prisma 7 + @prisma/adapter-pg
# -----------------------------------------------------------------------------

POSTGRES_USER=nexos
POSTGRES_PASSWORD=nexos_dev_password
POSTGRES_DB=nexos_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DATABASE_URL es la URL completa usada por Prisma en schema.prisma y prisma.config.ts
DATABASE_URL=postgresql://nexos:nexos_dev_password@localhost:5432/nexos_db

# Staging / Producción (Supabase managed Postgres o RDS):
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB>?sslmode=require

# -----------------------------------------------------------------------------
# REDIS (Token Blocklist + Colas BullMQ + Caché)
# -----------------------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nexos_redis_password

# URL completa usada por BullMQ e ioredis:
REDIS_URL=redis://:nexos_redis_password@localhost:6379

# -----------------------------------------------------------------------------
# MONGODB (Historial de Chats — NO para finanzas)
# Ver money-rules.md: MongoDB está PROHIBIDO para datos financieros.
# -----------------------------------------------------------------------------

MONGO_USER=nexos
MONGO_PASSWORD=nexos_mongo_password
MONGO_DB=nexos_chats
MONGO_HOST=localhost
MONGO_PORT=27017

MONGODB_URI=mongodb://nexos:nexos_mongo_password@localhost:27017/nexos_chats?authSource=admin

# -----------------------------------------------------------------------------
# SUPABASE AUTH (Identity Provider)
# NestJS valida los JWT de Supabase, nunca los emite.
# Obtener en: supabase.com → Proyecto → Settings → API
# -----------------------------------------------------------------------------

SUPABASE_URL=https://<PROJECT_ID>.supabase.co
SUPABASE_ANON_KEY=<REEMPLAZAR>
# JWT_SECRET es el secreto usado para validar la firma de los tokens en SupabaseGuard.
# Obtener en: supabase.com → Proyecto → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=<REEMPLAZAR>

# -----------------------------------------------------------------------------
# CLOUDFLARE R2 / AWS S3 (Almacenamiento de Archivos)
# Ver storage-rules.md para la política de acceso de cada bucket.
# El backend NUNCA sirve archivos directamente — solo genera URLs firmadas.
# -----------------------------------------------------------------------------

# Cloudflare R2 (recomendado — sin egress fees):
R2_ACCOUNT_ID=<REEMPLAZAR>
R2_ACCESS_KEY_ID=<REEMPLAZAR>
R2_SECRET_ACCESS_KEY=<REEMPLAZAR>
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Nombres de los buckets (ver architecture.md, sección 2.4):
R2_BUCKET_PUBLIC=nexos-public
R2_BUCKET_EVIDENCIAS=nexos-evidencias
R2_BUCKET_KYC=nexos-kyc
R2_BUCKET_INTERNAL=nexos-internal

# TTL de URLs firmadas en segundos (default: 900 = 15 minutos):
STORAGE_PRESIGNED_URL_TTL=900

# Si se usa AWS S3 en lugar de R2:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<REEMPLAZAR>
# AWS_SECRET_ACCESS_KEY=<REEMPLAZAR>

# -----------------------------------------------------------------------------
# PASARELA DE PAGOS (Integración Uruguay)
# Ver architecture.md sección 5 — Patrón Adapter/Port obligatorio.
# El backend verifica la firma del webhook antes de procesar cualquier evento.
# -----------------------------------------------------------------------------

# Secret para verificar la firma HMAC del webhook de la pasarela.
# Obtener en el dashboard del proveedor (RedPagos, MercadoPago UY, etc.).
PAYMENT_GATEWAY_WEBHOOK_SECRET=<REEMPLAZAR>

# URL base de la pasarela (ejemplo MercadoPago):
# PAYMENT_GATEWAY_BASE_URL=https://api.mercadopago.com
# PAYMENT_GATEWAY_ACCESS_TOKEN=<REEMPLAZAR>

# -----------------------------------------------------------------------------
# EXPO PUSH NOTIFICATIONS
# Para el envío de alertas de urgencias, confirmaciones de Escrow, etc.
# Ver architecture.md — Cola 4: push-notifications
# -----------------------------------------------------------------------------

# Token de acceso a la API de Expo (para envíos en producción):
EXPO_ACCESS_TOKEN=<REEMPLAZAR>

# -----------------------------------------------------------------------------
# VERIFICACIÓN DE IDENTIDAD KYC
# Proveedor externo para validar CI y documentos (ej. MetaMap / Truora).
# Ver architecture.md — Cola 3: kyc-processing
# -----------------------------------------------------------------------------

KYC_PROVIDER_API_KEY=<REEMPLAZAR>
KYC_PROVIDER_BASE_URL=https://api.metamap.com

# -----------------------------------------------------------------------------
# BULLMQ — SISTEMA Y CONSTANTES DE NEGOCIO
# Estas son las variables de configuración de las colas asíncronas.
# Todas deben residir en src/config/*.config.ts — ningún valor hardcodeado.
# -----------------------------------------------------------------------------

# UUID del usuario "sistema" que ejecuta las acciones automáticas de BullMQ
# (aceptación silenciosa, expiración de urgencias, etc.).
# DEBE existir como un User real en la DB con rol SUPER_ADMIN.
# Crear este usuario en seed antes del primer deploy.
SYSTEM_USER_ID=<UUID-del-usuario-sistema-en-postgresql>

# Aceptación silenciosa: días hábiles antes de liberar el Escrow automáticamente.
# addBusinessDays() de date-fns usará este valor. Ver escrow-logic.md Sección 5.
ESCROW_SILENT_ACCEPTANCE_BUSINESS_DAYS=2

# Comisión de la plataforma en porcentaje (ej. 10 = 10%).
# Usada por Money.percentage() en EscrowService. Nunca hardcodear en el código.
ESCROW_COMMISSION_PERCENT=10

# Radio de búsqueda de profesionales para Urgencias en metros (5000 = 5km, 10000 = 10km).
# Ver urgency-module.md — PostGIS ST_DWithin.
URGENCY_RADIUS_METERS=7000

# Tiempo en minutos antes de marcar una Urgencia como EXPIRED sin profesional.
URGENCY_EXPIRY_MINUTES=30

# Delays del Weighted Broadcast en milisegundos (ver urgency-module.md).
# BUSINESS recibe la alerta primero, FREE la recibe al final.
URGENCY_BROADCAST_DELAY_BUSINESS_MS=0
URGENCY_BROADCAST_DELAY_MEDIUM_MS=10000
URGENCY_BROADCAST_DELAY_FREE_MS=20000

# Tiempo máximo en horas antes de cancelar un EscrowTransaction en estado PENDING.
# Si el cliente no completa el pago en este tiempo, el Job vuelve a estar disponible.
ESCROW_PENDING_CLEANUP_HOURS=2

# TTL del cache de categorías en Redis (segundos). Default: 3600 = 1 hora.
CATEGORY_CACHE_TTL=3600

# TTL de Idempotency-Keys de Escrow en Redis (segundos). Default: 86400 = 24 horas.
ESCROW_IDEMPOTENCY_TTL=86400

# -----------------------------------------------------------------------------
# OBSERVABILIDAD
# Sentry captura errores no controlados y los envía al dashboard del equipo.
# Pino usa el nivel de log según el entorno (debug en dev, warn en producción).
# -----------------------------------------------------------------------------

SENTRY_DSN=<REEMPLAZAR>
# SENTRY_ENVIRONMENT se setea automáticamente desde NODE_ENV si no se define:
# SENTRY_ENVIRONMENT=production

# Nivel de log de Pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# En producción usar: LOG_LEVEL=warn
