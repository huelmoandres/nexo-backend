# =============================================================================
# NEXOS BACKEND — Variables de Entorno
# HRProgrammers
#
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.example .env
#   2. Completar todos los valores marcados con <REEMPLAZAR>
#   3. Nunca commitear el archivo .env (ya está en .gitignore)
#
# Referencia de configs: src/config/*.config.ts
# Valores comentados (#) muestran el default del código si omitís la variable.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVIDOR
# -----------------------------------------------------------------------------

NODE_ENV=development
# NODE_ENV=staging
# NODE_ENV=production

PORT=3000

# Zona IANA para fechas de negocio (cotización BCU, stale, crons locales).
# Default: America/Montevideo
# APP_TIMEZONE=America/Montevideo

# Orígenes CORS permitidos (separados por coma). Vacío = ningún origin explícito.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# API — Problem Details (RFC 7807)
# Base del campo `type` en respuestas de error (sin barra final).
# Default en código: https://nexos.com/errors
# -----------------------------------------------------------------------------
# PROBLEM_DETAIL_TYPE_BASE_URL=https://nexos.com/errors

# -----------------------------------------------------------------------------
# POSTGRESQL + POSTGIS
# Debe coincidir con docker-compose.yml en desarrollo local.
# -----------------------------------------------------------------------------

POSTGRES_USER=nexos
POSTGRES_PASSWORD=nexos_dev_password
POSTGRES_DB=nexos_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://nexos:nexos_dev_password@localhost:5432/nexos_db
# Staging / Producción:
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB>?sslmode=require

# -----------------------------------------------------------------------------
# SEEDS (prisma/seed.js) — solo desarrollo / staging controlado
# -----------------------------------------------------------------------------

# SEED_DEMO=0
# SEED_SKIP_BACKFILL=1
# SEED_STRESS=1
# STRESS_PRO_COUNT=500
# STRESS_BATCH_SIZE=30
# SEED_RANDOM=1
# SEED_FAKER_SEED=123
# ALLOW_TRUST_BACKFILL=1

# -----------------------------------------------------------------------------
# GEO — catálogo Uruguay + Google (src/config/geo.config.ts, google-maps.config.ts)
# Backend: habilitar Geocoding API en Google Cloud.
# Frontend (VITE_GOOGLE_MAPS_API_KEY): Maps JavaScript API + Places API (Autocomplete).
# Sin GOOGLE_MAPS_API_KEY en backend, POST /api/geo/resolve responde resolved=false (no rompe).
# -----------------------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=<REEMPLAZAR>
# GOOGLE_MAPS_TIMEOUT_MS=5000
# GEO_CACHE_TTL_SECONDS=86400
# GEO_RESOLVE_CACHE_TTL_SECONDS=604800
# SEED_GEO_LITE=1

# -----------------------------------------------------------------------------
# REDIS (blocklist JWT + BullMQ + cachés)
# -----------------------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nexos_redis_password

REDIS_URL=redis://:nexos_redis_password@localhost:6379

# Bull Board (docker compose --profile tools) — UI colas BullMQ en http://localhost:3030
# BULL_BOARD_USER=nexos
# BULL_BOARD_PASSWORD=nexos_dev

# Auth blocklist (src/config/auth.config.ts)
# REDIS_BLOCKLIST_PREFIX=blocklist:

# -----------------------------------------------------------------------------
# MONGODB (chat — roadmap; NO para finanzas)
# -----------------------------------------------------------------------------

MONGO_USER=nexos
MONGO_PASSWORD=nexos_mongo_password
MONGO_DB=nexos_chats
MONGO_HOST=localhost
MONGO_PORT=27017

MONGODB_URI=mongodb://nexos:nexos_mongo_password@localhost:27017/nexos_chats?authSource=admin

# -----------------------------------------------------------------------------
# SUPABASE AUTH
# NestJS valida JWT; no emite tokens. JWKS: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# -----------------------------------------------------------------------------

SUPABASE_URL=https://<PROJECT_ID>.supabase.co
SUPABASE_JWT_SECRET=<REEMPLAZAR>

# Solo para apps cliente (React Native / web). El backend Nest no la lee hoy.
# SUPABASE_ANON_KEY=<REEMPLAZAR>

# -----------------------------------------------------------------------------
# CLOUDFLARE R2 (almacenamiento de archivos — portfolio, KYC, etc.)
# -----------------------------------------------------------------------------

R2_ACCOUNT_ID=<REEMPLAZAR>
R2_ACCESS_KEY_ID=<REEMPLAZAR>
R2_SECRET_ACCESS_KEY=<REEMPLAZAR>
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

R2_BUCKET_PUBLIC=nexos-public
R2_BUCKET_EVIDENCIAS=nexos-evidencias
R2_BUCKET_KYC=nexos-kyc
R2_BUCKET_INTERNAL=nexos-internal

# STORAGE_PRESIGNED_URL_TTL=900

# Umbral WARN memoria Redis namespace storage:exists:* (bytes)
# STORAGE_EXISTS_MEMORY_WARN_BYTES=104857600

# -----------------------------------------------------------------------------
# AWS — moderación de imágenes (Amazon Rekognition)
# Credenciales estándar del SDK (IAM user con rekognition:DetectModerationLabels).
# Independientes de R2. Región del cliente Rekognition:
# -----------------------------------------------------------------------------
# AI_AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<REEMPLAZAR>
# AWS_SECRET_ACCESS_KEY=<REEMPLAZAR>

# -----------------------------------------------------------------------------
# IA — moderación de contenido (src/config/ai.config.ts + AiModule)
# Texto: OpenAI Moderation API. Imágenes: AWS Rekognition.
# -----------------------------------------------------------------------------

# AI_OPENAI_API_KEY=<REEMPLAZAR>
# AI_POLICY_VERSION=1.0.0
# AI_PROVIDER_TIMEOUT_MS=30000
# AI_CACHE_TTL_SECONDS=604800
# AI_CACHE_PG_ENABLED=true

# -----------------------------------------------------------------------------
# PORTFOLIO (src/config/portfolio.config.ts)
# -----------------------------------------------------------------------------

# Activar pipeline IA al publicar (debe ser exactamente "true")
# PORTFOLIO_AI_ENABLED=false

# Leído en config; el wiring actual usa OpenAI (texto) + Rekognition (imagen) siempre.
# PORTFOLIO_AI_PROVIDER=openai
# PORTFOLIO_AI_FAIL_OPEN=false
# PORTFOLIO_AI_RETRY_TOTAL_BUDGET_MS=600000

# PORTFOLIO_CONSENT_TTL_DAYS=14
# PORTFOLIO_REMINDER_DELAY_DAYS=3
# PORTFOLIO_PHOTOS_HEAD_TIMEOUT_MS=2000
# PORTFOLIO_PHOTOS_HEAD_CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# BÚSQUEDA (src/config/search.config.ts)
# -----------------------------------------------------------------------------

# SEARCH_DEFAULT_RADIUS_KM=5
# SEARCH_DEFAULT_LIMIT=10
# SEARCH_FTS_DICTIONARY=spanish

# Expansión de query con IA (sinónimos/variantes vía OpenAI)
# SEARCH_EXPANSION_ENABLED=true
# SEARCH_EXPANSION_TTL_SECONDS=604800
# SEARCH_EXPANSION_TIMEOUT_MS=2000
# SEARCH_EXPANSION_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# USUARIOS (src/config/users.config.ts)
# -----------------------------------------------------------------------------

# USERS_ROLE_CACHE_TTL_MS=30000
# Bucket KYC para presign de documentos (puede coincidir con R2_BUCKET_KYC)
# KYC_BUCKET=nexos-kyc

# -----------------------------------------------------------------------------
# CATEGORÍAS (src/config/categories.config.ts)
# -----------------------------------------------------------------------------

# CATEGORIES_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# DIAGNÓSTICOS DE ARRANQUE (src/config/diagnostics.config.ts)
# -----------------------------------------------------------------------------

# DIAGNOSTICS_TIMEOUT_MS=3000
# DIAGNOSTICS_FAIL_ON_SOFT=false

# -----------------------------------------------------------------------------
# OBSERVABILIDAD
# -----------------------------------------------------------------------------

SENTRY_DSN=<REEMPLAZAR>
# SENTRY_ENVIRONMENT se deriva de NODE_ENV si no se define.

LOG_LEVEL=debug
# En producción: LOG_LEVEL=warn

# -----------------------------------------------------------------------------
# PAGOS — Mercado Pago Uruguay (Checkout Pro)
# mock = webhook simple con PAYMENT_GATEWAY_WEBHOOK_SECRET (E2E / local)
# mercadopago = Preferences + notificaciones firmadas
# -----------------------------------------------------------------------------

# PAYMENT_GATEWAY_PROVIDER=mock
# PAYMENT_GATEWAY_PROVIDER=mercadopago

PAYMENT_GATEWAY_WEBHOOK_SECRET=dev-webhook-secret

# MERCADOPAGO_ACCESS_TOKEN=<Access Token de prueba desde Developers>
# MERCADOPAGO_PUBLIC_KEY=<Public Key — front opcional>
# MERCADOPAGO_WEBHOOK_SECRET=<Secreto de firma del webhook en panel MP>
# MERCADOPAGO_SANDBOX=true
# MERCADOPAGO_NOTIFICATION_URL=https://<ngrok>/api/payments/webhooks/mercadopago
# MERCADOPAGO_BACK_URL_SUCCESS=https://app.nexos.local/payment/success
# MERCADOPAGO_BACK_URL_FAILURE=https://app.nexos.local/payment/failure
# MERCADOPAGO_BACK_URL_PENDING=https://app.nexos.local/payment/pending
# Máximo de cuotas que el comprador puede elegir en Checkout Pro (1 = sin cuotas).
# MERCADOPAGO_MAX_INSTALLMENTS=12
# Preselección opcional (omitir para que elija el cliente en MP).
# MERCADOPAGO_DEFAULT_INSTALLMENTS=

# -----------------------------------------------------------------------------
# BILLING — Suscripciones SaaS (src/config/billing.config.ts)
# PRO USD 5/mes, BUSINESS USD 50/mes; trial 7d; dunning 10d
# -----------------------------------------------------------------------------

# BILLING_PRO_USD_CENTS=500
# BILLING_BUSINESS_USD_CENTS=5000
# BILLING_TRIAL_DAYS=7
# BILLING_GRACE_DAYS=10
# MERCADOPAGO_SUBSCRIPTION_NOTIFICATION_URL=https://<ngrok>/api/payments/webhooks/mercadopago/subscriptions
# Tras bootstrap API (opcional — si ya existen en MP):
# BILLING_MP_PRO_PREAPPROVAL_PLAN_ID=
# BILLING_MP_BUSINESS_PREAPPROVAL_PLAN_ID=

# -----------------------------------------------------------------------------
# PAYOUT al profesional (post-liberación escrow)
# manual = admin transfiere en MP y confirma con comprobante en S3
# gateway = issuePayout automático (mock o API futura)
# -----------------------------------------------------------------------------

PAYOUT_MODE=manual
# PAYOUT_MAX_ATTEMPTS=5

# =============================================================================
# ROADMAP — variables documentadas; aún SIN src/config/*.config.ts que las lea
# Mantener solo como referencia de producto futuro (escrow, urgencias…).
# =============================================================================

# EXPO_ACCESS_TOKEN=<REEMPLAZAR>

# KYC_PROVIDER_API_KEY=<REEMPLAZAR>
# KYC_PROVIDER_BASE_URL=https://api.metamap.com

# SYSTEM_USER_ID=<UUID-usuario-sistema>
# ESCROW_SILENT_ACCEPTANCE_BUSINESS_DAYS=2
# ESCROW_COMMISSION_PERCENT=10
# ESCROW_PENDING_CLEANUP_HOURS=2
# ESCROW_IDEMPOTENCY_TTL=86400
# URGENCY_RADIUS_METERS=7000
# URGENCY_EXPIRY_MINUTES=30
# URGENCY_BROADCAST_DELAY_BUSINESS_MS=0
# URGENCY_BROADCAST_DELAY_MEDIUM_MS=10000
# URGENCY_BROADCAST_DELAY_FREE_MS=20000
